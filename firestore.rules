rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return signedIn()
        && request.auth.token.email in [
          "wmgiruk@gmail.com",
          "jinethbinulaka@gmail.com",
          "randinu2@gmail.com"
        ];
    }

    function isAdmin() {
      return signedIn()
        && (
          isBootstrapAdmin()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
        );
    }

    function ownProfile(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validShortText(value, maxLength) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLength;
    }

    function validOptionalText(value, maxLength) {
      return value == null
        || (value is string && value.size() <= maxLength);
    }

    function validIndex(indexNumber) {
      return indexNumber is string
        && indexNumber.matches('^[A-Z0-9]{1,32}$');
    }

    function validUserProfile(uid) {
      return ownProfile(uid)
        && request.resource.data.keys().hasOnly([
          "email",
          "displayName",
          "photoURL",
          "role",
          "createdAt",
          "updatedAt"
        ])
        && request.resource.data.email == request.auth.token.email
        && validOptionalText(request.resource.data.displayName, 120)
        && validOptionalText(request.resource.data.photoURL, 500)
        && request.resource.data.role in ["admin", "user"];
    }

    function validStudent(indexNumber) {
      return request.resource.data.keys().hasOnly([
          "indexNumber",
          "name",
          "batch",
          "category",
          "createdByUid",
          "createdByEmail",
          "importedByUid",
          "importedByEmail",
          "updatedAt"
        ])
        && request.resource.data.indexNumber == indexNumber
        && validIndex(indexNumber)
        && validShortText(request.resource.data.name, 160)
        && request.resource.data.batch in ["22", "23", "24", "25", "other"]
        && request.resource.data.category in ["batch", "custom"];
    }

    function validEvent() {
      return request.resource.data.keys().hasOnly([
          "title",
          "description",
          "eventDate",
          "createdAt",
          "createdByUid",
          "createdByEmail"
        ])
        && validShortText(request.resource.data.title, 120)
        && validOptionalText(request.resource.data.description, 500)
        && request.resource.data.eventDate is string
        && request.resource.data.eventDate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdByEmail == request.auth.token.email;
    }

    function validAttendance(indexNumber) {
      return request.resource.data.keys().hasOnly([
          "indexNumber",
          "studentName",
          "batch",
          "category",
          "markedAt",
          "markedByUid",
          "markedByEmail"
        ])
        && request.resource.data.indexNumber == indexNumber
        && validIndex(indexNumber)
        && validShortText(request.resource.data.studentName, 160)
        && request.resource.data.batch in ["22", "23", "24", "25", "other"]
        && request.resource.data.category in ["batch", "custom"]
        && request.resource.data.markedByUid == request.auth.uid
        && request.resource.data.markedByEmail == request.auth.token.email;
    }

    match /users/{uid} {
      allow read: if ownProfile(uid) || isAdmin();
      allow create: if validUserProfile(uid)
        && (
          request.resource.data.role == "user"
          || (request.resource.data.role == "admin" && isBootstrapAdmin())
        );
      allow update: if validUserProfile(uid)
        && (
          isAdmin()
          || request.resource.data.role == resource.data.role
        );
      allow delete: if false;
    }

    match /students/{indexNumber} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validStudent(indexNumber);
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create, update: if isAdmin() && validEvent();
      allow delete: if isAdmin();

      match /attendance/{indexNumber} {
        allow read: if true;
        allow create, update: if isAdmin() && validAttendance(indexNumber);
        allow delete: if isAdmin();
      }
    }
  }
}
